# ===========================================================================
# Exchange selection
# ===========================================================================
# Choose which exchange to use: "okx", "bybit", "coinbase", or "hyperliquid"
EXCHANGE=coinbase

# ===========================================================================
# Coinbase API Credentials (used when EXCHANGE=coinbase)
# ===========================================================================
# Generate at: https://portal.cdp.coinbase.com/projects/api-keys
# Create a new API key with "Trade" permission
# Download the JSON key file — you need the 'name' and 'privateKey' fields.
#
# COINBASE_API_KEY is the "name" field (organizations/xxx/apiKeys/yyy)
# COINBASE_API_SECRET is the "privateKey" (full PEM including BEGIN/END lines)
#
# NOTE: Coinbase Advanced Trade has no public sandbox. Demo mode simulates
# orders locally using dry-run when COINBASE_DEMO_MODE=true.
# Available to Singapore users.

COINBASE_API_KEY=organizations/xxx/apiKeys/yyy
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHcCAQE...\n-----END EC PRIVATE KEY-----\n"
COINBASE_DEMO_MODE=true

# ===========================================================================
# Bybit API Credentials (used when EXCHANGE=bybit)
# ===========================================================================
# Generate at:
#   Testnet: https://testnet.bybit.com (recommended for testing)
#   Live:    https://www.bybit.com
# IMPORTANT: Only enable "Trade" permission. NEVER enable "Withdraw".
#
# Testnet keys ONLY work on testnet. Live keys ONLY work on live.

BYBIT_API_KEY=your-bybit-api-key-here
BYBIT_API_SECRET=your-bybit-api-secret-here

# Set to "true" for testnet (fake funds), "false" for live trading.
# Demo mode is the DEFAULT and RECOMMENDED starting point.
BYBIT_DEMO_MODE=true

# ===========================================================================
# OKX API Credentials (used when EXCHANGE=okx)
# ===========================================================================
# Generate at: OKX > Account > API Management > Create API Key
# IMPORTANT: Only enable "Trade" permission. NEVER enable "Withdraw".
# IMPORTANT: Set IP whitelist to your server's static IP.
#
# OKX Singapore (recommended for SG users):
#   - MAS-licensed (full MPI), accessible from Singapore
#   - Fees: 0.08% maker / 0.1% taker (4x cheaper than Coinbase)
#   - SGD deposits via FAST/PayNow
#   - Spot only for retail. Derivatives require Accredited Investor status.
#   - Use the same base URL (https://www.okx.com) for SG accounts.

OKX_API_KEY=your-okx-api-key-here
OKX_API_SECRET=your-okx-api-secret-here
OKX_PASSPHRASE=your-okx-passphrase-here
OKX_DEMO_MODE=true

# OKX regional base URL — set based on where you registered:
#   Global / Singapore: https://www.okx.com  (default)
#   Europe (EEA):       https://my.okx.com
#   US:                 https://app.okx.com
# OKX_BASE_URL=https://my.okx.com

# ===========================================================================
# Hyperliquid Credentials (used when EXCHANGE=hyperliquid)
# ===========================================================================
# Hyperliquid is a decentralized perpetual futures exchange.
# - No KYC, accessible from Singapore
# - Fees: 0.015% maker / 0.045% taker (perps)
# - Supports shorting (perpetual futures)
# - Use a DEDICATED wallet for trading — never your main wallet.
#
# Generate a new Ethereum wallet and fund it with USDC on Arbitrum,
# then deposit to Hyperliquid via https://app.hyperliquid.xyz/
#
# HL_PRIVATE_KEY is the wallet private key (hex, with or without 0x prefix)
# HL_VAULT_ADDRESS is optional — for vault-based trading
# HL_DEMO_MODE=true uses testnet (https://api.hyperliquid-testnet.xyz)

HL_PRIVATE_KEY=your-wallet-private-key-here
HL_DEMO_MODE=true
# HL_VAULT_ADDRESS=0x...

# ===========================================================================
# Telegram Bot (optional)
# ===========================================================================
# Install with: pip install neet-crypto-trader[telegram]
# Create a bot via @BotFather on Telegram, get your chat ID via @userinfobot
# TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789
