# ===========================================================================
# EXCHANGE SELECTION (single-exchange mode only)
# ===========================================================================
# Used when NO [[portfolios]] are defined in TOML config.
# In multi-exchange mode, this is ignored — each portfolio defines its exchange.
EXCHANGE=okx

# ===========================================================================
# OKX Singapore — MAS-licensed, recommended for SG users
# ===========================================================================
# SETUP:
#   1. Register at https://www.okx.com (Singapore accessible)
#   2. Complete KYC (required for trading)
#   3. Go to: Account → API Management → Create API Key
#   4. Permissions: check "Trade" ONLY. NEVER enable "Withdraw".
#   5. Set IP whitelist to your VPS static IP
#   6. Copy the API key, secret, and passphrase below
#
# Demo mode: Create SEPARATE keys while in "Demo Trading" mode on OKX website.
# Demo keys do NOT work on live, and vice versa.
#
# Fees: 0.08% maker / 0.1% taker (set exchange_fee_pct = 0.1 in config)
# Quote: USDT (deposit USDT to fund the account)

OKX_API_KEY=your-okx-api-key
OKX_API_SECRET=your-okx-api-secret
OKX_PASSPHRASE=your-okx-passphrase
OKX_DEMO_MODE=true

# ===========================================================================
# Hyperliquid — decentralized perps, no KYC, cheapest fees
# ===========================================================================
# SETUP:
#   1. Create a NEW Ethereum wallet (MetaMask, Rabby, or use a CLI tool)
#      IMPORTANT: Use a DEDICATED wallet — never your main wallet.
#   2. Fund with USDC on Arbitrum chain (bridge from any chain)
#   3. Deposit USDC to Hyperliquid: https://app.hyperliquid.xyz/
#   4. Copy the wallet private key below (hex, with or without 0x prefix)
#
# Demo mode: Uses testnet at https://api.hyperliquid-testnet.xyz
# Testnet has free test USDC — no real funds needed.
#
# Fees: 0.015% maker / 0.045% taker (set exchange_fee_pct = 0.045 in config)
# Quote: USDC (all settlement in USDC)
# Supports: Shorting (perpetual futures)

HL_PRIVATE_KEY=your-wallet-private-key
HL_DEMO_MODE=true
# HL_VAULT_ADDRESS=0x...   # Optional: for vault-based trading

# ===========================================================================
# Coinbase Advanced Trade — regulated, USD pairs
# ===========================================================================
# SETUP:
#   1. Register at https://www.coinbase.com (Singapore accessible)
#   2. Complete identity verification
#   3. Go to: https://portal.cdp.coinbase.com/projects/api-keys
#   4. Create API key with "Trade" permission ONLY
#   5. Download the JSON key file
#   6. COINBASE_API_KEY = the "name" field (organizations/xxx/apiKeys/yyy)
#   7. COINBASE_API_SECRET = the "privateKey" (full PEM including BEGIN/END)
#
# Demo mode: No public sandbox. COINBASE_DEMO_MODE=true simulates orders
# locally (dry-run) while using real market data.
#
# Fees: 0.4% taker (set exchange_fee_pct = 0.4 in config)
# Quote: USDC (pairs: BTC-USDC, ETH-USDC)
# Spot only: No shorting, no leverage

COINBASE_API_KEY=organizations/xxx/apiKeys/yyy
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHcCAQE...\n-----END EC PRIVATE KEY-----\n"
COINBASE_DEMO_MODE=true

# ===========================================================================
# Bybit (optional — geo-blocked in Singapore)
# ===========================================================================
# Only use if you have VPN access or are outside Singapore.
# SETUP:
#   Testnet: https://testnet.bybit.com → API Management → Create
#   Live: https://www.bybit.com → same flow
#   Testnet keys ONLY work on testnet.

BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret
BYBIT_DEMO_MODE=true

# ===========================================================================
# Telegram Bot (recommended)
# ===========================================================================
# SETUP:
#   1. Open Telegram, message @BotFather
#   2. Send /newbot, follow prompts, get the token
#   3. Message @userinfobot to get your chat ID
#   4. Fill in below

# TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# ===========================================================================
# Quant Alpha Engine (optional but recommended)
# ===========================================================================
# FRED API — free macro data (Fed rates, CPI, treasury yields)
# Register: https://fred.stlouisfed.org/docs/api/api_key.html (2 minutes)
# FRED_API_KEY=your-fred-api-key

# Anthropic API — LLM reasoning (~$0.50/day, explains trade decisions)
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ===========================================================================
# Config file override (optional)
# ===========================================================================
# NCT_CONFIG=config/paper-validation.toml    # Paper trading (start here)
# NCT_CONFIG=config/live-reduced.toml        # First live ($100/week)
# NCT_CONFIG=config/live-conservative.toml   # Scaled live ($300/week)
