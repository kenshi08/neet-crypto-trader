# OKX API Credentials
# Generate at: OKX > Account > API Management > Create API Key
# IMPORTANT: Only enable "Trade" permission. NEVER enable "Withdraw".
# IMPORTANT: Set IP whitelist to your server's static IP.

OKX_API_KEY=your-api-key-here
OKX_API_SECRET=your-api-secret-here
OKX_PASSPHRASE=your-passphrase-here

# Set to "true" for demo trading (fake funds), "false" for live trading.
# Demo mode is the DEFAULT and RECOMMENDED starting point.
OKX_DEMO_MODE=true

# OKX regional base URL — set based on where you registered:
#   Global:  https://www.okx.com  (default)
#   Europe:  https://my.okx.com
#   US:      https://app.okx.com
# OKX_BASE_URL=https://my.okx.com

# Telegram Bot (optional — install with: pip install neet-crypto-trader[telegram])
# Create a bot via @BotFather on Telegram, get your chat ID via @userinfobot
# TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789
